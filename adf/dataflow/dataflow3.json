{
	"name": "dataflow3",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_from_dest",
						"type": "DatasetReference"
					},
					"name": "sourcesalesfiles"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_reporting_container",
						"type": "DatasetReference"
					},
					"name": "sinksalestransformation"
				}
			],
			"transformations": [
				{
					"name": "selectcolumn"
				},
				{
					"name": "filterinvoiceinvalid"
				},
				{
					"name": "splitcountry"
				},
				{
					"name": "aggregateinvoice"
				}
			],
			"scriptLines": [
				"source(output(",
				"          InvoiceNo as string,",
				"          StockCode as string,",
				"          Description as string,",
				"          Quantity as short,",
				"          InvoiceDate as timestamp,",
				"          UnitPrice as double,",
				"          CustomerID as double,",
				"          Country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> sourcesalesfiles",
				"sourcesalesfiles select(mapColumn(",
				"          InvoiceNo,",
				"          Description,",
				"          InvoiceDate,",
				"          UnitPrice,",
				"          CustomerID,",
				"          Country",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectcolumn",
				"selectcolumn filter(InvoiceNo !='537669',",
				"     partitionBy('hash', 1)) ~> filterinvoiceinvalid",
				"filterinvoiceinvalid split(Country =='United Kingdom',",
				"     Country=='Germany',",
				"     Country=='Australia',",
				"     disjoint: false,",
				"     partitionBy('hash', 1)) ~> splitcountry@(UK, Germany, Australia, other)",
				"splitcountry@UK aggregate(groupBy(InvoiceNo),",
				"     UnitPrice = sum(toInteger(UnitPrice)),",
				"     partitionBy('hash', 1)) ~> aggregateinvoice",
				"aggregateinvoice sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinksalestransformation"
			]
		}
	}
}